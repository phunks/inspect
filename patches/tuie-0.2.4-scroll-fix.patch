 fn piecewise_remap(progress: f32, anchor_in: f32, anchor_out: f32) -> f32 {
+    // Piecewise-linearly remaps `progress` so that:
+    //   0.0 maps to 0.0,
+    //   `anchor_in` maps to `anchor_out`,
+    //   1.0 maps to 1.0.
+    if progress <= 0.0 {

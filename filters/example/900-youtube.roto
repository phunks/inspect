//! +++
//! name = "youtube"
//! enabled = true
//! priority = 900
//!
//! [trigger]
//! host = ["*doubleclick.net", "www.youtube.com", "*.googlesyndication.com"]
//! path = ["*"]
//! method = ["GET","POST"]
//! phase = ["request", "response"]
//!
//!
//! +++

fn ping() -> bool {
    true
}

fn request_action(req: Request) -> RequestAction {
    let path = req.path();
    if path.contains("/ddm/activity_ext")
        || path.contains("/activeview_ext")
        || path == "/pagead/interaction/"
        || path == "/api/stats/ads"
        || path == "/pagead/adview"
        || path == "/api/stats/qoe"
        || path == "/youtubei/v1/log_event"
        || path == "/pagead/id"
        || path.contains("/viewthroughconversion")
        || path == "/youtubei/v1/player/ad_break"
        || path.contains("/ddm/trackimp")
        || path == "/instream/ad_status.js"
    {
        RequestAction.pass()
            .mark("youtube")
            .drop()
    } else {
        RequestAction.pass()
    }
}

fn response_action(res: Response) -> ResponseAction {
    if res.content_type().contains("text/html") {
        ResponseAction.pass()
            .mark("b64-test")
            .replace_body_text_once_b64(
                "KGZ1bmN0aW9uIHNlcnZlckNvbnRyYWN0KCk=",
                "",
            )
    } else {
        ResponseAction.pass()
    }
}
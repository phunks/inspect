//! +++
//! name = "deny apple"
//! enabled = true
//!
//! [trigger]
//! host = ["*apple.com"]
//! path = ["*"]
//! phase = ["request"]
//! +++

fn ping() -> bool {
    true
}

fn request_action(req: Request) -> RequestAction {
    RequestAction.pass()
        .mark("apple")
        .synthetic_response(
            200,
            "<!doctype html><html><body><h1>Hello from Roto</h1><p>synthetic response</p></body></html>",
            "text/html; charset=utf-8",
        )
}


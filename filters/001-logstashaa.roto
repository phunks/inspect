//! +++
//! name = "post response to logstash"
//! enabled = true
//!
//! [trigger]
//! host = ["*"]
//! path = ["*"]
//! phase = ["response"]
//! +++

fn ping() -> bool {
    true
}

fn response_action(res: Response) -> ResponseAction {
    ResponseAction.pass()
        .mark("logstash")
        .post_flow_json("logstash", "/")
}

